{{ $root := . }}

{{ define "walk" }}
    {{ $data := .data }}
    {{ $path := .path }}
    {{ $root := .root }}
    {{ $ancestors := .ancestors }}

    {{ range $name, $api := $data }}
        {{ if eq $name "_api" }}
            {{ continue }}
        {{ end }}

        {{ $childPath := path.Join $path $name }}

        {{ if isset $api "_api" }}

            {{ $childApi := $api._api }}
            {{ $members := default (slice) $childApi.members }}

            {{ range $memberName, $memberApi := $api }}
                {{ if eq $memberName "_api" }}
                    {{ continue }}
                {{ end }}

                {{ if isset $memberApi "_api" }}

                    {{/* Nested directory: use its _api.yaml as the member */}}
                    {{ $member := merge
                        $memberApi._api
                        (dict "name" $memberName)
                    }}

                    {{ $members = collections.Append $member $members }}

                {{ else }}

                    {{/* File: use the file's API as the member */}}
                    {{ $member := merge
                        $memberApi
                        (dict "name" $memberName)
                    }}

                    {{ $members = collections.Append $member $members }}

                {{ end }}
            {{ end }}

            {{ $root.AddPage (dict
                "kind" "page"
                "path" $childPath
                "url" (printf "/spur/reference/%s/" $childPath)
                "title" $name
                "params" (merge
                    $childApi
                    (dict
                        "apiAncestors" $ancestors
                        "name" $name
                        "members" $members
                    )
                )
            ) }}

            {{ $childAncestors := collections.Append
                (dict
                    "name" $name
                    "url" (printf "/spur/reference/%s/" $childPath)
                )
                $ancestors
            }}

            {{ range $member := $childApi.members }}
                {{ $memberPath := path.Join $childPath $member.name }}

                {{ $root.AddPage (dict
                    "kind" "page"
                    "path" $memberPath
                    "url" (printf "/spur/reference/%s/" $memberPath)
                    "title" $member.name
                    "params" (merge
                        (dict
                            "apiAncestors" $childAncestors
                        )
                        $member
                    )
                ) }}
            {{ end }}

            {{ if and (eq $childApi.kind "class") (isset $childApi "initializer") }}
                {{ $memberPath := path.Join $childPath "__init" }}

                {{ $root.AddPage (dict
                    "kind" "page"
                    "path" $memberPath
                    "url" (printf "/spur/reference/%s/" $memberPath)
                    "title" "__init"
                    "params" (merge
                        (dict 
                            "apiAncestors" $childAncestors
                            "kind" "initializer"
                            "name" "__init"
                        )
                        $childApi.initializer
                    )
                ) }}
            {{ end }}

            {{ template "walk" (dict
                "data" $api
                "root" $root
                "path" $childPath
                "ancestors" $childAncestors
            ) }}

        {{ else }}

            {{ $root.AddPage (dict
                "kind" "page"
                "path" $childPath
                "url" (printf "/spur/reference/%s/" $childPath)
                "title" $name
                "params" (merge
                    (dict 
                        "apiAncestors" $ancestors
                        "name" $name
                    )
                    $api
                )
            ) }}

            {{ $memberAncestors := collections.Append
                (dict
                    "name" $name
                    "url" (printf "/spur/reference/%s/" $childPath)
                )
                $ancestors
            }}
            {{ range $index, $member := $api.members }}
                {{ $memberPath := path.Join $childPath $member.name }}

                {{ $root.AddPage (dict
                    "kind" "page"
                    "path" $memberPath
                    "url" (printf "/spur/reference/%s/" $memberPath)
                    "title" $member.name
                    "params" (merge
                        (dict 
                            "apiAncestors" $memberAncestors
                        )
                        $member
                    )
                ) }}
            {{ end }}

            {{ if and (eq $api.kind "class") (isset $api "initializer") }}
                {{ $memberPath := path.Join $childPath "__init" }}

                {{ $root.AddPage (dict
                    "kind" "page"
                    "path" $memberPath
                    "url" (printf "/spur/reference/%s/" $memberPath)
                    "title" "__init"
                    "params" (merge
                        (dict 
                            "apiAncestors" $memberAncestors
                            "kind" "initializer"
                            "name" "__init"
                        )
                        $api.initializer
                    )
                ) }}
            {{ end }}

        {{ end }}
    {{ end }}
{{ end }}

{{ template "walk" (dict
    "data" hugo.Data.spur.reference
    "root" $root
    "path" ""
    "ancestors" (slice)
) }}